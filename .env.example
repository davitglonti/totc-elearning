# TOTC E-Learning Environment Variables Example
# In production, set these via Docker / Kubernetes / Cloud hosting environment variables or secrets manager.
# NEVER commit production secrets to public source control.

# JWT Authentication Secret (Minimum 32 characters, recommended 64-char hex)
Jwt__Secret=YOUR_STRONG_RANDOM_JWT_SECRET_KEY_MINIMUM_32_CHARS
Jwt__Issuer=TOTC-LMS
Jwt__Audience=TOTC-Students
Jwt__ExpiresInDays=7

# Bunny Stream Video CDN Credentials
BunnyStream__LibraryId=YOUR_BUNNY_STREAM_LIBRARY_ID
BunnyStream__ApiKey=YOUR_BUNNY_STREAM_API_KEY
BunnyStream__CdnHostname=vz-f0959c15-d92.b-cdn.net

# TOTC E-Learning Environment Variables Example
# In production, set these via Docker / Kubernetes / Cloud hosting environment variables or secrets manager.
# NEVER commit production secrets to public source control.

# Database Configuration (PostgreSQL 17)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_replace_in_prod
POSTGRES_DB=elearning

# Administrator Initial Provisioning (Required for Production Seeding)
Admin__Email=admin@totc.com
Admin__Password=your_strong_admin_password_here

# JWT Authentication Secret (Minimum 64-character random hex string)
Jwt__Secret=your_secure_random_jwt_secret_minimum_64_characters
Jwt__Issuer=TOTC-LMS
Jwt__Audience=TOTC-Students
Jwt__ExpiresInDays=7

# Bunny Stream Video CDN Credentials
BunnyStream__LibraryId=805955
BunnyStream__ApiKey=your_bunny_api_key_here
BunnyStream__TokenSecurityKey=your_bunny_token_security_key_here
BunnyStream__CdnHostname=vz-f0959c15-d92.b-cdn.net

# Payment Webhook Secrets (Stripe / Payment Gateway)
Payment__WebhookSecret=your_stripe_webhook_secret
Stripe__WebhookSecret=your_stripe_webhook_secret

# CORS Allowed Origins (Comma-separated)
Cors__AllowedOrigins=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# Google OAuth 2.0 Client ID (from Google Cloud Console)
Google__ClientId=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com

# Email Service Configuration (Resend, SMTP, or Console fallback)
Email__Provider=Console
Email__ApiKey=your_resend_api_key_or_empty_for_console
Email__FromAddress=no-reply@totc.ge
Email__FromName=TOTC Academy
Email__FrontendUrl=http://localhost:5173
